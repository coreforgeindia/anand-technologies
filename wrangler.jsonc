{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "anand-technologies",
	"compatibility_date": "2026-05-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "DATASHEETS",
			"bucket_name": "anand-technologies-datasheets"
		}
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://fbwcipiqridnpxmxodct.supabase.co"
	},
	"observability": {
		"enabled": true
	}
}
